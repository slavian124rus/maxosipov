# syntax=docker/dockerfile:1
# Образ для локальной разработки (docker/compose.local.yml): исходники монтируются снаружи,
# здесь только инструменты. Продакшн-образ — docker/Dockerfile.
FROM node:22-bookworm-slim

ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    NEXT_TELEMETRY_DISABLED=1
RUN corepack enable

# ffmpeg (с libvidstab) и python для видео-пайплайна и подсветки мышц — как в продакшн-образе.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    ffmpeg python3 python3-venv ca-certificates curl git \
    libgl1 libegl1 libgles2 libglib2.0-0 \
 && rm -rf /var/lib/apt/lists/*

COPY media-tools/requirements.txt /tmp/mt-requirements.txt
RUN python3 -m venv /opt/mt \
 && /opt/mt/bin/pip install --no-cache-dir -r /tmp/mt-requirements.txt \
 && mkdir -p /opt/mt/models \
 && curl -fsSL -o /opt/mt/models/pose_landmarker_heavy.task \
    https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_heavy/float16/latest/pose_landmarker_heavy.task \
 && echo "64437af838a65d18e5ba7a0d39b465540069bc8aae8308de3e318aad31fcbc7b  /opt/mt/models/pose_landmarker_heavy.task" | sha256sum -c -

WORKDIR /app
