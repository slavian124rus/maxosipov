# Скопируй в .env и заполни. Секреты в репозиторий не попадают.

# База данных
# пароль БД для docker/compose.yml (подставляется в DATABASE_URL контейнеров)
POSTGRES_PASSWORD=
DATABASE_URL=
TEST_DATABASE_URL=

# Адреса
APP_URL=
SITE_URL=

# Секрет подписи сессий (не короче 32 символов)
AUTH_SECRET=

# Вход: VK ID, Яндекс ID
VK_CLIENT_ID=
VK_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# СМС: console — печатает код в лог (dev), smsru / smsaero — реальная отправка (нужен SMS_API_KEY)
SMS_PROVIDER=console
SMS_API_KEY=
# Только для smsaero: логин из кабинета и имя отправителя (пусто = бесплатное «SMS Aero», только для тестов)
SMS_AERO_LOGIN=
SMS_AERO_SIGN=

# Почта: коды входа. console — печатает письмо в лог (dev), smtpbz — реальная отправка через HTTP API SMTP.bz
EMAIL_PROVIDER=console
SMTPBZ_API_KEY=
# Адрес отправителя; домен должен быть подтверждён в кабинете SMTP.bz (например noreply@maxosipov.ru)
EMAIL_FROM=
EMAIL_FROM_NAME=МаксИИм

# ИИ (plusvibeapi, OpenAI-совместимый)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_MAIN=
AI_MODEL_FAST=
AI_MODEL_FALLBACK=

# Распознавание речи: по умолчанию plusvibe + whisper-large-v3 на AI_API_KEY и AI_BASE_URL
# выше — отдельные значения нужны, только чтобы сменить провайдера, модель или адрес.
STT_PROVIDER=
STT_MODEL=
STT_BASE_URL=
YANDEX_SPEECHKIT_KEY=

# Telegram: заявки с лендинга в группу тренера. Токен — у @BotFather, chat id группы — см. docs/ops/telegram-leads.md
TELEGRAM_BOT_TOKEN=
TELEGRAM_LEADS_CHAT_ID=

# Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@maxosipov.ru

# Медиа
MEDIA_ROOT=
MEDIA_URL_SIGNING_SECRET=

# Пароль базы для docker compose (POSTGRES_PASSWORD)
POSTGRES_PASSWORD=
# Бэкапы
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
RESTIC_PASSWORD=

# Сид: в production создаются только зал, роли и эти два пользователя
SEED_OWNER_PHONE=
SEED_TRAINER_PHONE=
SEED_OWNER_EMAIL=
SEED_TRAINER_EMAIL=
