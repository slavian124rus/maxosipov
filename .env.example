# Скопируй в .env и заполни. Секреты в репозиторий не попадают.

# База данных
# пароль БД для docker/compose.yml (подставляется в DATABASE_URL контейнеров)
POSTGRES_PASSWORD=
DATABASE_URL=
TEST_DATABASE_URL=

# Адреса
APP_URL=
SITE_URL=

# Секрет подписи сессий (не короче 32 символов)
AUTH_SECRET=

# Вход: VK ID, Яндекс ID
VK_CLIENT_ID=
VK_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# СМС: console — печатает код в лог (dev), smsru — реальная отправка (нужен SMS_API_KEY)
SMS_PROVIDER=console
SMS_API_KEY=

# ИИ (plusvibeapi, OpenAI-совместимый)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_MAIN=
AI_MODEL_FAST=
AI_MODEL_FALLBACK=

# Распознавание речи
STT_PROVIDER=
STT_MODEL=
YANDEX_SPEECHKIT_KEY=

# Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Медиа
MEDIA_ROOT=
MEDIA_URL_SIGNING_SECRET=

# Пароль базы для docker compose (POSTGRES_PASSWORD)
POSTGRES_PASSWORD=
# Бэкапы
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
RESTIC_PASSWORD=

# Сид: в production создаются только зал, роли и эти два пользователя
SEED_OWNER_PHONE=
SEED_TRAINER_PHONE=
